# Official Python 3.12.14 image and uv 0.11.32, resolved September 12, 2026.
FROM python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254 AS base

FROM base AS build
COPY --from=ghcr.io/astral-sh/uv:0.11.32@sha256:df4cae8f3a96d175e2e5f992e597550000edbe78fdc2594d5cd8de1a217f504c /uv /usr/local/bin/uv
ENV UV_PYTHON_DOWNLOADS=never UV_PROJECT_ENVIRONMENT=/opt/venv UV_LINK_MODE=copy
WORKDIR /build
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN uv sync --locked --no-dev --no-editable --no-cache

FROM base AS runtime
ENV PATH="/opt/venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 XDG_CACHE_HOME=/app/.local/cache
WORKDIR /app
COPY --from=build /opt/venv /opt/venv
COPY certs/supabase-prod-ca-2021.crt ./certs/supabase-prod-ca-2021.crt
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin worker \
    && mkdir /app/.local && chown worker:worker /app/.local
USER 10001:10001
# Host scheduling supervises this bounded command; no server or trading endpoint.
CMD ["python", "-m", "sportsbet.daily", "--mode", "public_monitor", "--sport", "both"]
