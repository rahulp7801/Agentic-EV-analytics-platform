# Copy to .env for Python development. Never commit real credentials.
# Use the exact host/user/SSL settings from your database provider.
# URL-encode special characters in passwords; both URLs address the same database.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sportsbet
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:postgres@localhost:5432/sportsbet
POSTGRES_DB=sportsbet
LOG_LEVEL=INFO

# Required for live odds. No LLM API key is consumed by the current graph.
ODDS_API_KEY=

# Set to the writable PostgreSQL URL for durable hosted audit/exposure storage.
# Leave unset for local SQLite analytics. Run Alembic migrations before use.
# ANALYTICS_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sportsbet

BANKROLL_USD=10000
# Fraction of full Kelly (0.25 = quarter Kelly), not a per-bet bankroll cap.
MAX_KELLY_FRACTION=0.25
VIG_METHOD=multiplicative
EXPERIMENTAL_PROBABILITY_ADJUSTMENTS=false

# Deployment credentials belong in platform settings, not this file:
# GitHub Actions repository secret: VERCEL_TOKEN
# GitHub Actions repository variables: VERCEL_ORG_ID, VERCEL_PROJECT_ID
# Vercel production server environment: DATABASE_URL (read-only PostgreSQL role)
# Never prefix credentials with NEXT_PUBLIC_.
